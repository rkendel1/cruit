{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screening-assurance.dev/schemas/manifest.schema.json",
  "title": "Knowledge pack manifest",
  "type": "object",
  "required": ["pack", "version", "status", "documents", "changelog"],
  "additionalProperties": false,
  "properties": {
    "pack": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "in_review", "approved"] },
    "approved_by": { "type": "string" },
    "approved_at": { "type": "string" },
    "documents": {
      "type": "object",
      "required": ["synonyms", "equivalencies", "skills"],
      "additionalProperties": false,
      "properties": {
        "synonyms": { "type": "string" },
        "equivalencies": { "type": "string" },
        "skills": { "type": "string" }
      }
    },
    "changelog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["version", "date", "author", "summary"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string" },
          "author": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    }
  }
}
