{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screening-assurance.dev/schemas/candidate_pool.schema.json",
  "title": "Authorized candidate pool",
  "description": "De-identified candidate evidence that is NOT limited to applicants of the current requisition: prior applicants, talent-community members, or other authorized records. Used for rediscovery against a requisition. No names, contact details, photos or protected characteristics. A prior application is context, never permission to contact.",
  "type": "object",
  "required": ["pool_id", "source_system", "exported_at", "authorization", "candidates"],
  "additionalProperties": false,
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
    "use": { "enum": ["rediscovery_review", "screening_audit", "original_requisition_only"] },
    "coverage": { "enum": ["complete", "partial", "not_supplied"] }
  },
  "properties": {
    "pool_id": { "type": "string", "maxLength": 80 },
    "source_system": { "type": "string", "maxLength": 80 },
    "exported_at": { "$ref": "#/$defs/date" },
    "description": { "type": "string", "maxLength": 1000 },
    "max_evidence_age_days": {
      "description": "Records whose evidence is older than this are not surfaced for action.",
      "type": "integer", "minimum": 1, "maximum": 3650
    },
    "authorization": {
      "type": "object",
      "required": ["basis", "de_identified", "permitted_uses", "retention_days", "deletion"],
      "additionalProperties": false,
      "properties": {
        "basis": { "type": "string", "maxLength": 500 },
        "de_identified": { "const": true },
        "permitted_uses": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/use" } },
        "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
        "deletion": {
          "description": "What happens to candidate-level data in the local workspace when retention ends or the employer requests deletion.",
          "enum": ["delete_candidate_data", "delete_workspace_session"]
        },
        "granted_by": { "type": "string", "maxLength": 200 }
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["id", "source_record_ref", "evidence_updated_at", "evidence_provenance", "evidence_coverage", "experience"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,40}$" },
          "source_record_ref": {
            "description": "Opaque reference to the source record. The employer keeps the mapping to real identities.",
            "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,80}$"
          },
          "evidence_updated_at": { "$ref": "#/$defs/date" },
          "evidence_provenance": { "enum": ["application_resume", "talent_community_profile", "recruiter_notes_structured", "assessment_summary"] },
          "evidence_coverage": {
            "description": "Whether each kind of evidence is complete, partial, or not supplied. Gaps in a partial record are treated as unknown, not as absence.",
            "type": "object",
            "required": ["experience", "credentials"],
            "additionalProperties": false,
            "properties": {
              "experience": { "$ref": "#/$defs/coverage" },
              "credentials": { "$ref": "#/$defs/coverage" }
            }
          },
          "authorization": {
            "description": "Candidate-level overrides of the pool authorization.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "permitted_uses": { "type": "array", "items": { "$ref": "#/$defs/use" } },
              "expires_at": { "$ref": "#/$defs/date" }
            }
          },
          "prior_applications": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": ["requisition_ref", "applied_at", "outcome"],
              "additionalProperties": false,
              "properties": {
                "requisition_ref": { "type": "string", "maxLength": 80 },
                "role_title": { "type": "string", "maxLength": 120 },
                "applied_at": { "$ref": "#/$defs/date" },
                "outcome": { "enum": ["rejected", "withdrawn", "not_selected", "hired_elsewhere_in_org", "unknown"] },
                "recorded_reason": { "type": "string", "maxLength": 200 }
              }
            }
          },
          "contact_status": {
            "description": "Only when supplied by the employer. Never inferred. Informational: the workbench performs no outreach.",
            "enum": ["do_not_contact", "no_preference_recorded", "opted_in_talent_community"]
          },
          "experience": {
            "type": "array",
            "maxItems": 40,
            "items": {
              "type": "object",
              "required": ["title", "months", "summary"],
              "additionalProperties": false,
              "properties": {
                "title": { "type": "string", "maxLength": 160 },
                "domain": { "type": "string", "maxLength": 80 },
                "months": { "type": "integer", "minimum": 0, "maximum": 720 },
                "summary": { "type": "string", "maxLength": 4000 }
              }
            }
          },
          "skills": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 120 } },
          "credentials": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 160 } },
          "education": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 200 } },
          "learning": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 200 } }
        }
      }
    }
  }
}
