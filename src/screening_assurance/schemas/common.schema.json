{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screening-assurance.dev/schemas/common.schema.json",
  "title": "Shared definitions for Screening Assurance contracts",
  "$defs": {
    "confidence": { "enum": ["high", "medium", "low"] },
    "review_status": { "enum": ["draft", "proposed", "approved", "deprecated"] },
    "contexts": {
      "description": "Job-family identifiers this record applies to. '*' means all job families.",
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(\\*|[a-z0-9][a-z0-9-]*)$" }
    },
    "term_list": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "provenance": {
      "type": "object",
      "required": ["author", "created", "sources"],
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "created": { "type": "string", "format": "date" },
        "updated": { "type": "string", "format": "date" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "approved_by": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
