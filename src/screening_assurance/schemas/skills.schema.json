{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://screening-assurance.dev/schemas/skills.schema.json",
  "title": "Skills and capability relationships document",
  "description": "Skills as structured, contextual capabilities, plus capability combinations that may evidence a broader capability.",
  "type": "object",
  "required": ["document", "schema_version", "records"],
  "additionalProperties": false,
  "properties": {
    "document": { "const": "skills" },
    "schema_version": { "const": 1 },
    "records": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
    "combinations": { "type": "array", "items": { "$ref": "#/$defs/combination" } }
  },
  "$defs": {
    "skill_id": { "type": "string", "pattern": "^skill\\.[a-z0-9][a-z0-9.-]*$" },
    "skill": {
      "type": "object",
      "required": ["id", "name", "kind", "definition", "alternate_names", "evidence_types", "contexts", "confidence", "version", "review_status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/skill_id" },
        "name": { "type": "string", "minLength": 1 },
        "kind": {
          "description": "'regulated_credential' marks licenses/certifications that are legally or contractually required where stated. The engine never proposes alternatives for them.",
          "enum": ["skill", "capability", "tool", "credential", "regulated_credential"]
        },
        "definition": { "type": "string", "minLength": 1 },
        "alternate_names": { "$ref": "common.schema.json#/$defs/term_list" },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "target"],
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["closely_related", "prerequisite", "supports", "transferable", "not_equivalent"] },
              "target": { "$ref": "#/$defs/skill_id" },
              "note": { "type": "string" }
            }
          }
        },
        "proficiency_levels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "description"],
            "additionalProperties": false,
            "properties": {
              "level": { "enum": ["foundational", "working", "advanced", "expert"] },
              "description": { "type": "string" }
            }
          }
        },
        "evidence_types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "contexts": { "$ref": "common.schema.json#/$defs/contexts" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "version": { "type": "integer", "minimum": 1 },
        "review_status": { "$ref": "common.schema.json#/$defs/review_status" },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
      }
    },
    "combination": {
      "type": "object",
      "required": ["id", "name", "components", "min_components", "supports", "rationale", "limitations", "confidence", "version", "review_status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^combo\\.[a-z0-9][a-z0-9.-]*$" },
        "name": { "type": "string" },
        "components": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/skill_id" } },
        "min_components": { "type": "integer", "minimum": 2 },
        "supports": { "$ref": "#/$defs/skill_id" },
        "rationale": { "type": "string" },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "version": { "type": "integer", "minimum": 1 },
        "review_status": { "$ref": "common.schema.json#/$defs/review_status" },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
      }
    }
  }
}
